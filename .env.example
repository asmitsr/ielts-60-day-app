# IELTS 60-Day App — environment variables
# Copy this file to `.dev.vars` for local development (it is git-ignored).
# For production, set secrets with `wrangler pages secret put <NAME>`
# and plain variables in the Cloudflare Pages dashboard
# (Settings > Environment variables) or in wrangler.toml [vars].
# NEVER commit real values. NEVER put secrets in frontend code.

# SESSION_SECRET (required, server-side secret)
# A random 32+ byte secret used to sign session cookies.
# Generate one with:  openssl rand -hex 32
# Local dev: put it in `.dev.vars`.
# Production: wrangler pages secret put SESSION_SECRET
SESSION_SECRET=

# ALLOW_REGISTRATION (optional, default "true")
# Set to "false" to disable open registration for a private deployment.
# When "false", POST /api/auth/register returns 403; existing users can
# still log in. Set it in wrangler.toml [vars] or the Pages dashboard.
ALLOW_REGISTRATION=true

# GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN / GMAIL_SENDER
# (required for forgot-password emails, server-side secrets)
# Gmail API OAuth credentials for the Google Cloud project (Gmail API
# enabled, External OAuth app in production, gmail.send scope only). The
# refresh token comes from the OAuth Playground with the project's OAuth
# client. GMAIL_SENDER is the sending Gmail address (the gmail.send scope
# does not cover the profile lookup, so the sender is configured, not
# read from the API). Without all four, POST /api/auth/forgot-password
# returns 503 with a clear error — no fake reset email is ever pretended.
# Local dev: put them in `.dev.vars`.
# Production: set all four as Pages secrets in the Cloudflare dashboard
# (Settings > Environment variables > Production, type Secret).
GMAIL_CLIENT_ID=<redacted>
GMAIL_CLIENT_SECRET=<redacted>
GMAIL_REFRESH_TOKEN=<redacted>
GMAIL_SENDER=<redacted>

# AI_KEY_SECRET (required for the in-app AI assistant, server-side secret)
# A random 32+ character string used to AES-GCM-encrypt each user's own
# AI API key before it is stored in D1 (key = SHA-256 of this secret).
# The plaintext key is never stored, logged, or returned. Without this
# secret the AI endpoints fail closed with 503 (no fake AI answers).
# Generate one with:  openssl rand -hex 32
# Local dev: put it in `.dev.vars`.
# Production: wrangler pages secret put AI_KEY_SECRET
AI_KEY_SECRET=<redacted>

# D1 database binding (set in wrangler.toml, not here):
#   [[d1_databases]] binding = "DB", database_name = "ielts-60day-db"
# Create it with:  npx wrangler d1 create ielts-60day-db
# Then paste the returned database_id into wrangler.toml.
